# PFDD tests on Cu with rotated lattice, edge dislocation and relaxation (no stress)
# PFDD Lippmann-Schwinger formulation (Murgas et al., 2026)
# Please don't modify this file. Create a copy outside the pfdd folder of your code
seed             576
app_style       FCCEdgeRotated core_energy 1 setup StraightOrtho gb_energy 0
fft_style       fftw_slab_ls pbc 1 1 1 mode 1 primitive x 1 -1 0 y 1 1 -2 z 1 1 1 # cubic
dimension        3
lattice         sc/6n 1
# cubic edge dislocation
region          box block 0 64 0 64 0 64
create_box       box
create_sites     box
# Isotropic Case
#material        preset Cu aflag 1 mu 40.427E9 lambda 111.1187E9  C11 191.9727e9 C12 111.1187e9 C13 111.1187e9 C14 0.0 C15 0.0 C16 0.0 C22 191.9727e9 C23 111.1187e9 C24 0.0 C25 0.0 C26 0.0 C33 191.9727e9 C34 0.0 C35 0.0 C36 0.0 C44 40.427e9 C45 0.0 C46 0.0 C55 40.427e9 C56 0.0 C66 40.427e9 error_tol 1E-5
material        preset Cu aflag 1
solve_style      GLLS max_iter 500 tol 1e-8
diag_style      strain
diag_style      stress
temperature          700
scale           1.0 1.0 1.0
